  "events": [],
  "exports": [
    {
      "description": "添加账户，如果已存在则设为启用",
      "name": "account.add",
      "params_schema": {
        "properties": {
          "game_id": {
            "type": "string"
          },
          "game_server": {
            "type": "string"
          },
          "qq_id": {
            "type": "integer"
          }
        },
        "required": [
          "qq_id",
          "game_server",
          "game_id"
        ],
        "type": "object"
      },
      "result_schema": {
        "type": "object"
      }
    },
    {
