{
  "author": "amiabot",
  "commands": [
    {
      "description": "解析 bilibili av/bv/b23 链接",
      "handler": "Handle",
      "id": "cmd.bilibili",
      "match_raw": false,
      "name": "bilibili",
      "pattern": "(?i)\\b(?:av(\\d+)|(bv1[0-9a-zA-Z]+)|(?:(?:https?://)?b23\\.tv/([a-z0-9]+)))\\b"
    }
  ],
  "config": {
    "default": {
      "amiabot_pages": "",
      "bilibili_downloader_server": ""
    },
    "description": "Bilibili 插件配置",
    "schema": {
      "additionalProperties": true,
      "properties": {
        "amiabot_pages": {
          "type": "string"
        },
        "bilibili_downloader_server": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "version": "1"
  },
  "crons": [],
  "dependencies": [
    "external.screenshot",
    "external.blobserver"
  ],
  "description": "B站视频解析与卡片",
  "events": [],
  "exports": [],
  "name": "Amiabot Bilibili",
  "plugin_id": "external.amiabot-bilibili",
  "version": "0.1.0"
}