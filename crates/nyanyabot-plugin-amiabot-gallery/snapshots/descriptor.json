{
  "author": "nyanyabot",
  "commands": [
    {
      "description": "新建画廊标签",
      "handler": "HandleCreateTag",
      "id": "cmd.gallery-create-tag",
      "match_raw": false,
      "name": "gallery-create-tag",
      "pattern": "(?i)^新建tag(?P<tag>.+)$"
    },
    {
      "description": "将当前消息或引用消息中的图片上传到画廊",
      "handler": "HandleUpload",
      "id": "cmd.gallery-upload",
      "match_raw": false,
      "name": "gallery-upload",
      "pattern": "(?i)^上传(?P<tag>.+)$"
    },
    {
      "description": "按图片 ID 或标签查看画廊中的图片",
      "handler": "HandleView",
      "id": "cmd.gallery-view",
      "match_raw": false,
      "name": "gallery-view",
      "pattern": "(?i)^看(?P<input>.+)$"
    }
  ],
  "config": {
    "default": {
      "amiabot_pages": "",
      "gallery_read_token": "",
      "gallery_server": "http://127.0.0.1:25006",
      "gallery_write_token": ""
    },
    "description": "Amiabot Gallery 插件配置",
    "schema": {
      "additionalProperties": true,
      "properties": {
        "amiabot_pages": {
          "description": "Amiabot Pages 地址，用于生成重复图片对比卡",
          "type": "string"
        },
        "gallery_read_token": {
          "description": "Gallery Server 读令牌",
          "type": "string"
        },
        "gallery_server": {
          "description": "Gallery Server 的 API / Render 地址，默认 http://127.0.0.1:25006",
          "type": "string"
        },
        "gallery_write_token": {
          "description": "Gallery Server 写令牌",
          "type": "string"
        }
      },
      "type": "object"
    },
    "version": "1"
  },
  "crons": [],
  "dependencies": [
    "external.screenshot",
    "external.blobserver"
  ],
  "description": "画廊插件，支持创建标签、上传图片，以及按图片 ID 或标签查看图片",
  "events": [],
  "exports": [],
  "name": "Amiabot Gallery",
  "plugin_id": "external.amiabot-gallery",
  "version": "0.1.0"
}