{
  "name": "Amiabot PJSK Event",
  "plugin_id": "external.amiabot-pjsk-event",
  "version": "0.1.0",
  "author": "nyanyabot",
  "description": "PJSK 活动查询插件，发送截图",
  "dependencies": [
    "external.screenshot",
    "external.blobserver"
  ],
  "exports": [],
  "config": {
    "version": "1",
    "description": "Amiabot PJSK Event plugin config",
    "schema": {
      "additionalProperties": true,
      "properties": {
        "amiabot_pages": {
          "description": "Amiabot Pages 域名/地址；为空则无法生成截图 URL",
          "type": "string"
        },
        "default_server": {
          "description": "默认服务器 (jp/cn/en/tw/kr)，不填时为 jp",
          "type": "string"
        }
      },
      "type": "object"
    },
    "default": {
      "amiabot_pages": "",
      "default_server": "jp"
    }
  },
  "commands": [
    {
      "name": "pjsk-event",
      "id": "cmd.pjsk-event",
      "description": "PJSK 活动查询（如 event, jpevent, cn查活动, enevent50）",
      "pattern": "^(?i)(?:(?P<server>cn|jp|tw|en|kr))?(?:event|查活动)(?P<id>[0-9]*)$",
      "match_raw": true,
      "handler": "Handle"
    }
  ],
  "events": [],
  "crons": []
}
