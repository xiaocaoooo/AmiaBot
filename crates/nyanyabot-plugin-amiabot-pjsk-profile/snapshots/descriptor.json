{
  "name": "Amiabot PJSK Profile",
  "plugin_id": "external.amiabot-pjsk-profile",
  "version": "0.1.0",
  "author": "nyanyabot",
  "description": "PJSK 个人信息查询插件，发送 profile 截图",
  "dependencies": [
    "external.amiabot-pjsk-account",
    "external.screenshot",
    "external.blobserver"
  ],
  "exports": [],
  "config": {
    "version": "1",
    "description": "Amiabot PJSK Profile plugin config",
    "schema": {
      "additionalProperties": true,
      "properties": {
        "amiabot_pages": {
          "description": "Amiabot Pages 域名/地址；为空则无法生成截图 URL",
          "type": "string"
        },
        "default_server": {
          "description": "默认服务器 (jp/cn/en/tw/kr)，不填时为 jp",
          "type": "string"
        }
      },
      "type": "object"
    },
    "default": {
      "amiabot_pages": "",
      "default_server": "jp"
    }
  },
  "commands": [
    {
      "name": "pjsk-profile",
      "id": "cmd.profile-show",
      "description": "查看 PJSK 个人信息（如 profile, 个人信息, cn个人信息）",
      "pattern": "^(?:(?P<server>cn|jp|tw|en|kr))?(?:个人信息|profile)$",
      "match_raw": false,
      "handler": "Handle"
    }
  ],
  "events": [],
  "crons": []
}
